# Puerto del servidor
PORT=3000

# El traductor funciona sin configurar nada: aprende de las cartas oficiales de Scryfall
# y usa traducción automática gratuita para lo que falte.

# Idiomas cuya memoria de traducción se prepara al arrancar (separados por comas)
MEMORY_WARMUP=es

# Opcional: email para MyMemory (sube su límite gratuito diario)
MYMEMORY_EMAIL=

# Opcional: si tienes una clave de Anthropic, Claude traduce primero y el motor propio queda de respaldo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
