# Puerto del servidor
PORT=3000

# Clave de la API de Anthropic (Claude) para la traducción por IA.
# Sin clave, la app usa traducciones oficiales (Scryfall / MTG.io) y MyMemory como respaldo.
ANTHROPIC_API_KEY=

# Modelo y nivel de esfuerzo para las traducciones (opcionales)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Email opcional para MyMemory (sube el límite diario gratuito de 5.000 a 50.000 caracteres)
MYMEMORY_EMAIL=
